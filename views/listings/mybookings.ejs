<% layout("/layouts/boilerplate") -%>

<h3 class="mt-3"><i class="fa-solid fa-calendar-check" style="color: #fe424d;"></i> My Bookings</h3>

<% if(bookings.length > 0) { %>
    <div class="row mt-3">
        <% for(let booking of bookings) { %>
            <div class="col-12 col-md-6 col-lg-4 mb-4">
                <div class="card booking-card">
                    <% if(booking.listing) { %>
                        <img 
                            src="<%= (booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" 
                            class="card-img-top" 
                            alt="listing image"
                            style="height: 180px; object-fit: cover;"
                        >
                        <div class="card-body">
                            <h5 class="card-title"><%= booking.listing.title %></h5>
                            <p class="card-text text-muted mb-1">
                                <i class="fa-solid fa-location-dot"></i> 
                                <%= booking.listing.location %>, <%= booking.listing.country %>
                            </p>
                            <div class="booking-dates mt-2">
                                <div class="booking-date-row">
                                    <span class="booking-date-label">Check-in</span>
                                    <span class="booking-date-value"><%= booking.checkin.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                </div>
                                <div class="booking-date-row">
                                    <span class="booking-date-label">Check-out</span>
                                    <span class="booking-date-value"><%= booking.checkout.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                </div>
                            </div>
                            <div class="booking-summary mt-2">
                                <span><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></span>
                                <span class="booking-total">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="booking-status <%= booking.status %>">
                                    <%= booking.status === 'confirmed' ? 'Confirmed' : 'Cancelled' %>
                                </span>
                                <% if(booking.status === 'confirmed') { %>
                                    <form method="POST" action="/listings/bookings/<%= booking._id %>/cancel" class="d-inline">
                                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Cancel this booking?')">Cancel</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="card-body">
                            <p class="text-muted">Listing has been removed</p>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
<% } else { %>
    <div class="no-results">
        <i class="fa-regular fa-calendar no-results-icon"></i>
        <h3>No bookings yet</h3>
        <p>Book your first stay and it will appear here.</p>
        <a href="/listings" class="btn btn-dark">Browse Listings</a>
    </div>
<% } %>
