<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Edit Listing</h3>
        <form method="POST" action="/listings/<%= specificListing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input name="listing[title]" value="<%= specificListing.title %>" type="text" class="form-control" required>
                <div class="invalid-feedback">Title is required.</div>
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" class="form-control" required><%= specificListing.description %></textarea>
                <div class="invalid-feedback">Please enter a short description.</div>
            </div>

            <div class="mb-3">
                Original Listing Image: <br>
                <img 
                    src="<%= (specificListing.image && specificListing.image.url) ? specificListing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" 
                    class="edit-img mt-2 mb-2" 
                    style="width: 250px; border-radius: 10px;"
                >
            </div>

            <div class="mb-3">
                <label for="image" class="form-label">Upload New Image</label>
                <input name="listing[image]" type="file" class="form-control">
                <div class="valid-feedback">File selection is optional.</div>
            </div>

            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" value="<%= specificListing.price %>" type="number" class="form-control" min="0" required>
                    <div class="invalid-feedback">Price must be 0 or more.</div>
                </div>

                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" value="<%= specificListing.country %>" type="text" class="form-control" required>
                    <div class="invalid-feedback">Country name is required.</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input name="listing[location]" value="<%= specificListing.location %>" type="text" class="form-control" required>
                <div class="invalid-feedback">Location is required.</div>
            </div> 

            <button class="btn btn-dark edit-btn mt-3">Save Changes</button>
        </form>
        <br><br>
    </div>
</div>