<% layout("/layouts/boilerplate") -%>

<div class="d-flex justify-content-between align-items-center mt-3">
    <h3 class="mb-0">My Listings</h3>
    <span class="text-muted" style="font-size: 0.9rem;"><%= allListings.length %> listing<%= allListings.length !== 1 ? 's' : '' %></span>
</div>

<% if(allListings.length > 0) { %>
    <div class="row mt-3">
        <% for(let listing of allListings) { %>
            <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-4">
                <div class="card listing-card my-listing-card">
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <img 
                            src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" 
                            class="card-img-top listing-card-img" 
                            alt="listing image"
                        >
                    </a>
                    <div class="card-body">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <p class="card-text mb-1">
                                <b><%= listing.title %></b>
                            </p>
                            <span class="gst-base-price" data-price="<%= listing.price %>">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> <span class="text-muted" style="font-size: 0.85rem;">/ night</span>
                        </a>
                        <% if(listing.category) { %>
                            <span class="category-tag"><%= listing.category %></span>
                        <% } %>
                        <div class="my-listing-actions mt-2">
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm my-listing-edit-btn">
                                <i class="fa-solid fa-pen"></i> Edit
                            </a>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                                <button class="btn btn-sm my-listing-delete-btn" onclick="return confirm('Delete this listing?')">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
<% } else { %>
    <div class="no-results">
        <i class="fa-solid fa-house no-results-icon"></i>
        <h3>No listings yet</h3>
        <p>You haven't created any listings. Start sharing your space!</p>
        <a href="/listings/new" class="btn btn-dark">Create Listing</a>
    </div>
<% } %>
