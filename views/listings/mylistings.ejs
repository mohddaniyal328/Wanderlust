<% layout("/layouts/boilerplate") -%>

<h3 class="mt-3">My Listings</h3>

<% if(allListings.length > 0) { %>
    <div class="row row-cols-1 row-cols-sm-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 mt-3">
        <% for(let listing of allListings) { %>
            <div class="col mb-4">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card">
                        <img 
                            src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" 
                            class="card-img-top listing-card-img" 
                            alt="listing image"
                        >
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b> <br>
                                <span class="gst-base-price" data-price="<%= listing.price %>">&#8377; <%= listing.price.toLocaleString("en-IN") %></span> / night
                            </p>
                            <% if(listing.category) { %>
                                <span class="category-tag"><%= listing.category %></span>
                            <% } %>
                            <div class="mt-2">
                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-dark">Edit</a>
                                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this listing?')">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
<% } else { %>
    <div class="no-results">
        <i class="fa-solid fa-house no-results-icon"></i>
        <h3>No listings yet</h3>
        <p>You haven't created any listings. Start sharing your space!</p>
        <a href="/listings/new" class="btn btn-dark">Create Listing</a>
    </div>
<% } %>
