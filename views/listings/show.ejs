<% layout("/layouts/boilerplate") -%>


<div class="row mt-3">
    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div>
                <h3><%= specificListing.title %></h3>
                <% if (specificListing.reviews && specificListing.reviews.length > 0) { %>
                    <div class="listing-rating-summary mb-3 d-flex align-items-center">
                        <span class="rating-star-icon"><i class="fa-solid fa-star"></i></span>
                        <span class="rating-value ms-1 fw-bold"><%= averageRating %></span>
                        <span class="rating-separator mx-2">&middot;</span>
                        <span class="reviews-count text-decoration-underline fw-semibold"><%= specificListing.reviews.length %> <%= specificListing.reviews.length === 1 ? 'review' : 'reviews' %></span>
                    </div>
                <% } %>
            </div>
            <% if(currUser) { %>
                <form method="POST" action="/listings/<%= specificListing._id %>/wishlist" class="d-inline">
                    <button type="submit" class="btn btn-link wishlist-btn" title="Save to wishlist">
                        <% 
                            let isWishlisted = false;
                            if(currUser.wishlists && currUser.wishlists.length > 0) {
                                for(let w of currUser.wishlists) {
                                    if(w.toString() === specificListing._id.toString()) {
                                        isWishlisted = true;
                                        break;
                                    }
                                }
                            }
                        %>
                        <% if(isWishlisted) { %>
                            <i class="fa-solid fa-heart" style="color: #fe424d; font-size: 1.4rem;"></i>
                        <% } else { %>
                            <i class="fa-regular fa-heart" style="color: #222; font-size: 1.4rem;"></i>
                        <% } %>
                    </button>
                </form>
            <% } %>
        </div>
    </div>

    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 show-listing-container">
        <!-- HERO IMAGE -->
        <div class="show-hero-image">
            <img src="<%= (specificListing.image && specificListing.image.url) ? specificListing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" class="show-img" alt="listing_image">
        </div>

        <!-- LISTING DETAILS GRID -->
        <div class="show-details-section mt-3">
            <div class="show-host-info">
                <i class="fa-solid fa-user-circle"></i>
                Hosted by <strong><%= specificListing.owner ? specificListing.owner.username : "Unknown Admin" %></strong>
            </div>
            <p class="show-description"><%= specificListing.description %></p>
            <div class="show-meta-row">
                <span class="show-price">&#8377; <%= specificListing.price.toLocaleString("en-IN") %> <small>/ night</small></span>
                <span class="show-location-badge">
                    <i class="fa-solid fa-location-dot"></i> 
                    <%= specificListing.location %>, <%= specificListing.country %>
                </span>
            </div>

            <!-- GST SECTION -->
            <div class="show-gst-section">
                <button type="button" class="show-gst-toggle">
                    <i class="fa-solid fa-percent"></i> Include 18% GST
                </button>
                <% 
                    const gstAmount = Math.round(specificListing.price * 0.18);
                    const totalWithGst = specificListing.price + gstAmount;
                %>
                <div class="show-gst-breakdown">
                    <div class="gst-line">
                        <span>Base Price</span>
                        <span>&#8377; <%= specificListing.price.toLocaleString("en-IN") %></span>
                    </div>
                    <div class="gst-line">
                        <span>GST (18%)</span>
                        <span>&#8377; <%= gstAmount.toLocaleString("en-IN") %></span>
                    </div>
                    <div class="gst-line total">
                        <span>Total with GST</span>
                        <span>&#8377; <%= totalWithGst.toLocaleString("en-IN") %></span>
                    </div>
                </div>
            </div>

            <!-- BOOKING SECTION -->
            <% if(currUser && !(specificListing.owner && specificListing.owner._id.equals(currUser._id))) { %>
                <div class="booking-section mt-3">
                    <div class="booking-header">
                        <span class="booking-price">&#8377; <%= specificListing.price.toLocaleString("en-IN") %> <small>/ night</small></span>
                    </div>
                    <form action="/listings/<%= specificListing._id %>/book" method="POST" class="booking-form needs-validation" novalidate>
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="checkin" class="form-label">Check-in</label>
                                <input type="date" id="checkin" name="checkin" class="form-control" required
                                    min="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="col-6">
                                <label for="checkout" class="form-label">Check-out</label>
                                <input type="date" id="checkout" name="checkout" class="form-control" required
                                    min="<%= new Date(Date.now() + 86400000).toISOString().split('T')[0] %>">
                            </div>
                        </div>
                        <div id="booking-summary" class="booking-summary-info mt-2" style="display: none;">
                            <div class="d-flex justify-content-between">
                                <span id="nights-count"></span>
                                <span id="total-price"></span>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-book w-100 mt-2">Reserve</button>
                        <p class="text-center text-muted mt-1" style="font-size: 0.8rem;">You won't be charged yet</p>
                    </form>
                </div>
            <% } else if (!currUser) { %>
                <div class="booking-section mt-3">
                    <a href="/login" class="btn btn-book w-100">Login to Book</a>
                </div>
            <% } %>
        </div>
    </div>

    <% if(currUser && specificListing.owner && specificListing.owner._id.equals(currUser._id)) { %>
        <div class="btns col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-3">
            <a href="/listings/<%= specificListing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
            
            <form method="POST" action="/listings/<%= specificListing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-dark del-btn ms-2">Delete</button>
            </form>
        </div>
    <% } %>

    <hr class="col-10 offset-1 col-lg-6 offset-lg-3">

    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-3">
        <% if(currUser) { %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= specificListing._id %>/reviews" method="POST" novalidate class="needs-validation">
                
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
        <% } %>

        <% if(specificListing.reviews.length > 0) { %>
            <h4 class="reviews-section-title">
                <i class="fa-solid fa-star" style="color: #fe424d;"></i>
                <%= averageRating %> &middot; <%= specificListing.reviews.length %> <%= specificListing.reviews.length === 1 ? 'review' : 'reviews' %>
            </h4>

            <!-- RATING BREAKDOWN -->
            <div class="rating-breakdown mb-3">
                <% for (let i = 5; i >= 1; i--) { %>
                    <% let count = specificListing.reviews.filter(r => r.rating === i).length; %>
                    <% let pct = Math.round((count / specificListing.reviews.length) * 100); %>
                    <div class="breakdown-row">
                        <span class="breakdown-label"><%= i %></span>
                        <div class="breakdown-bar-track">
                            <div class="breakdown-bar-fill" style="width: <%= pct %>%;"></div>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="row">
                <% for(let review of specificListing.reviews) { %>
                    <div class="col-12 col-sm-6 col-md-5 review-card ms-md-3 mb-3">
                        <div class="review-card-body">
                            <div class="review-header d-flex align-items-center">
                                <div class="review-avatar"><%= (review.author ? review.author.username : "A").charAt(0).toUpperCase() %></div>
                                <div class="review-author-info ms-2">
                                    <strong>@<%= review.author ? review.author.username : "Anonymous" %></strong>
                                    <div class="review-date text-muted"><%= review.createdAt ? review.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long' }) : '' %></div>
                                </div>
                            </div>
                            <p class="starability-result review-stars mt-2" data-rating="<%= review.rating %>"></p>
                            <p class="review-comment"><%= review.comment %></p>
                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form class="mb-3" method="POST" action="/listings/<%= specificListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
            <hr>
        <% } %>
    </div>

    <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2 mb-3">
        <h3>Where you'll be</h3>
        <div id="map" class="show-map"></div>
    </div>
</div>

<div id="listing-data" data-listing="<%= encodeURIComponent(JSON.stringify(specificListing)) %>" style="display: none;"></div>

<script src="/js/map.js"></script>