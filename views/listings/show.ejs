<% layout("/layouts/boilerplate") -%>


<div class="row mt-3">
    <div class="col-8 offset-3">
        <h3><%= specificListing.title %></h3>
        <% if (specificListing.reviews && specificListing.reviews.length > 0) { %>
            <div class="listing-rating-summary mb-3 d-flex align-items-center">
                <span class="rating-star-icon"><i class="fa-solid fa-star"></i></span>
                <span class="rating-value ms-1 fw-bold"><%= averageRating %></span>
                <span class="rating-separator mx-2">&middot;</span>
                <span class="reviews-count text-decoration-underline fw-semibold"><%= specificListing.reviews.length %> <%= specificListing.reviews.length === 1 ? 'review' : 'reviews' %></span>
            </div>
        <% } %>
    </div>

    <div class="card col-6 offset-3 show-card listing-card">
        <img 
            src="<%= (specificListing.image && specificListing.image.url) ? specificListing.image.url : 'https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=1080' %>" 
            class="card-img-top show-img" 
            alt="listing_image"
        >
        
        <div class="card-body">
            <p class="card-text">
                Owned by: <i><%= specificListing.owner ? specificListing.owner.username : "Unknown Admin" %></i>
            </p>
            
            <p class="card-text"><b><%= specificListing.description %></b></p>
            
            <p class="card-text">&#8377; <%= specificListing.price.toLocaleString("en-IN") %></p>
            
            <p class="card-text"><%= specificListing.location %></p>
            <p class="card-text"><%= specificListing.country %></p>
        </div>
    </div>

    <% if(currUser && specificListing.owner && specificListing.owner._id.equals(currUser._id)) { %>
        <div class="btns offset-3 mb-3">
            <a href="/listings/<%= specificListing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>
            
            <form method="POST" action="/listings/<%= specificListing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-dark del-btn ms-2">Delete</button>
            </form>
        </div>
    <% } %>

    <hr class="offset-3 col-6">

    <div class="col-8 offset-3 mb-3">
        <% if(currUser) { %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= specificListing._id %>/reviews" method="POST" novalidate class="needs-validation">
                
                <div class="mb-3 mt-3">
                    <label class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">Please add some comments for review</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
        <% } %>

        <% if(specificListing.reviews.length > 0) { %>
            <p><b>All Reviews</b></p>
            <div class="row">
                <% for(let review of specificListing.reviews) { %>
                    <div class="card col-5 ms-3 mb-3">
                        <div class="card-body">
                            <h5 class="card-title">@<%= review.author ? review.author.username : "Anonymous" %></h5>
                            <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                            <p class="card-text"><%= review.comment %></p>
                            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                                <form class="mb-3" method="POST" action="/listings/<%= specificListing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                    <button class="btn btn-sm btn-dark">Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
            <hr>
        <% } %>
    </div>

    <div class="col-8 offset-3 mb-3">
        <h3>Where you'll be</h3>
        <div id="map" style="height: 400px; width: 100%; border-radius: 15px; border: 1px solid #ddd;"></div>
    </div>
</div>

<script id="listing-data" type="application/json">
    <%- JSON.stringify(specificListing) %>
</script>

<script src="/js/map.js"></script>