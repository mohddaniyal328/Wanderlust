<% layout("/layouts/boilerplate") -%>

<div class="error-page text-center py-5">
    <div class="error-icon mb-4">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h1 class="error-title"><%= err.statusCode || 500 %></h1>
    <h2 class="error-subtitle mb-3"><%= err.message || "Something went wrong!" %></h2>
    <p class="error-desc mb-4">The page you're looking for doesn't exist or an error occurred.</p>
    <a href="/listings" class="btn btn-dark btn-lg px-5 py-2">
        <i class="fa-solid fa-house me-2"></i>Back to Home
    </a>
</div>
